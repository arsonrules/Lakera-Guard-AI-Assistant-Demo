# ── Required ──────────────────────────────────────────────────────────────────
# Lakera Guard API key — get yours at https://platform.lakera.ai
LAKERA_GUARD_API_KEY=
# Optional Lakera project id — sent with every Guard call to apply that project's
# policy. Leave blank to use the key's default project.
LAKERA_PROJECT_ID=
# Optional Guard region. Blank → Community (https://api.lakera.ai). Accepts a
# region host or full URL, e.g. https://eu-west-1.api.lakera.ai (EU/Ireland),
# https://us.api.lakera.ai (US multi-region), https://ap-southeast-1.api.lakera.ai (Asia).
LAKERA_ENDPOINT=

# ── LLM provider ────────────────────────────────────────────────────────────────
# The demo speaks the OpenAI-compatible Chat Completions API, so it works with
# OpenRouter (cloud) or any on-prem / local server (LM Studio, Ollama, oMLX).
# These set the *startup default*; you can also switch providers live in the UI
# (the "LLM:" button in the header).
#
#   openrouter → https://openrouter.ai/api/v1   (needs an API key)
#   lmstudio   → http://localhost:1234/v1        (LM Studio local server)
#   ollama     → http://localhost:11434/v1       (Ollama OpenAI-compatible API)
#   omlx       → http://localhost:10240/v1       (mlx-omni-server / Apple MLX)
#   custom     → any OpenAI-compatible /v1 endpoint
LLM_PROVIDER=openrouter
# Leave LLM_BASE_URL / LLM_MODEL blank to use the provider's preset defaults.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# ── Independent LLM-as-judge (optional) ─────────────────────────────────────────
# By default the one-shot judge uses the target model above. To grade with a
# different (usually stronger) model — so a weak local target isn't judging its
# own output — set these. All blank → judge with the target model.
JUDGE_PROVIDER=
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=

# ── Target Test endpoints ───────────────────────────────────────────────────────
# There is deliberately NO setting here for the third-party endpoint that Target
# Test mode (UI: the "Target Test" tab; CLI: --target-file) fires a dataset at.
# Its headers are the operator's credentials for someone else's service, so a
# target is per-run and in-memory only — never written to this file, never stored
# in a saved run, and never sent back to the browser.

# ── Back-compat (OpenRouter-only configuration) ─────────────────────────────────
# If set and the LLM_* fields above are blank, these seed the OpenRouter defaults.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# ── Operations ──────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
# One JSON object per log line — set true in containers for log collectors.
LOG_JSON=false
# This app handles adversarial prompts and PII fixtures, so prompt/response
# bodies are NEVER logged unless you explicitly opt in here.
LOG_PROMPTS=false

# ── Access control (see README → "Deployment & Security Boundary") ──────────────
# The demo has NO per-user authentication. Blank is safe only on loopback.
# Set a token to require it on every /api/* call:
#   Authorization: Bearer <token>   — or —   X-Demo-Token: <token>
DEMO_ACCESS_TOKEN=
# Binding to a non-loopback address without a token refuses to boot. Set true
# only if that exposure is deliberate (containers are exempt — the published
# port is the real boundary there).
ALLOW_INSECURE_BIND=false
